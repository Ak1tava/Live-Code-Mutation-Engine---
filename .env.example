LCME_ADDR=:8080
LCME_PUBLIC_URL=http://localhost:8080
LCME_DATA_DIR=./data
LCME_WORK_DIR=./work
# docker or local (local runs untrusted code without isolation; development only)
LCME_RUNNER=docker
LCME_RUNNER_IMAGE=lcme-runner:latest
LCME_RUNNER_BIN=./bin/lcme-runner
# Without a key, hints are template-based
OPENROUTER_API_KEY=
# Model ID from openrouter.ai/models (required together with the key)
LCME_LLM_MODEL=
